{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    // mvn -Dmaven.test.skip=true -Dcheckstyle.skip=true clean package install

    {
      "type": "java",
      "name": "MQAdmin:listTools",
      "request": "launch",
      "mainClass": "org.apache.rocketmq.tools.command.MQAdminStartup",
      "projectName": "rocketmq-tools",
      "args": [
      ],
      "vmArgs": "-Duser.home=/workspaces/rocketmq/develop/mqadmin",
      "env": {
        "ROCKETMQ_HOME": "/workspaces/rocketmq/develop/mqadmin"
      }
    },

    // Start the Name Server
    {
      "type": "java",
      "name": "NamesrvStartup",
      "request": "launch",
      "mainClass": "org.apache.rocketmq.namesrv.NamesrvStartup",
      "projectName": "rocketmq-namesrv",
      "args": [
        "-c",
        "/workspaces/rocketmq/develop/namesrv/conf/namesrv.properties"
      ],
      "env": {
        "ROCKETMQ_HOME": "/workspaces/rocketmq/develop/namesrv"
      }
    },
    // Start the Broker a-0
    {
      "type": "java",
      "name": "BrokerStartup-a-0",
      "request": "launch",
      "mainClass": "org.apache.rocketmq.broker.BrokerStartup",
      "projectName": "rocketmq-broker",
      "args": [
        "-c",
        "/workspaces/rocketmq/develop/broker-a-0/conf/broker.properties"
      ],
      "env": {
        "ROCKETMQ_HOME": "/workspaces/rocketmq/develop/broker-a-0"
      }
    },
    // Start the Broker a-1
    {
      "type": "java",
      "name": "BrokerStartup-a-1",
      "request": "launch",
      "mainClass": "org.apache.rocketmq.broker.BrokerStartup",
      "projectName": "rocketmq-broker",
      "args": [
        "-c",
        "/workspaces/rocketmq/develop/broker-a-1/conf/broker.properties"
      ],
      "env": {
        "ROCKETMQ_HOME": "/workspaces/rocketmq/develop/broker-a-1"
      }
    },
    // List the cluster
    {
      "type": "java",
      "name": "MQAdmin:clusterList",
      "request": "launch",
      "mainClass": "org.apache.rocketmq.tools.command.MQAdminStartup",
      "projectName": "rocketmq-tools",
      "args": [
        "clusterList",
        "--namesrvAddr",
        "127.0.0.1:9876"
      ],
      "vmArgs": "-Duser.home=/workspaces/rocketmq/develop/mqadmin",
      "env": {
        "ROCKETMQ_HOME": "/workspaces/rocketmq/develop/mqadmin"
      }
    },
    // create topic
    {
      "type": "java",
      "name": "MQAdmin:createTopic",
      "request": "launch",
      "mainClass": "org.apache.rocketmq.tools.command.MQAdminStartup",
      "projectName": "rocketmq-tools",
      "args": [
        "updateTopic",
        "-c",
        "DefaultCluster",
        "-n",
        "127.0.0.1:9876",
        "-p",
        "6",
        "-r",
        "1",
        "-w",
        "1",
        "-t",
        "TopicTest",
      ],
      "vmArgs": "-Duser.home=/workspaces/rocketmq/develop/mqadmin",
      "env": {
        "ROCKETMQ_HOME": "/workspaces/rocketmq/develop/mqadmin"
      }
    },
    // list topic
    {
      "type": "java",
      "name": "MQAdmin:listTopic",
      "request": "launch",
      "mainClass": "org.apache.rocketmq.tools.command.MQAdminStartup",
      "projectName": "rocketmq-tools",
      "args": [
        "topicList",
        "-n",
        "127.0.0.1:9876"
      ],
      "vmArgs": "-Duser.home=/workspaces/rocketmq/develop/mqadmin",
      "env": {
        "ROCKETMQ_HOME": "/workspaces/rocketmq/develop/mqadmin"
      }
    },
    {
      "type": "java",
      "name": "MQAdmin:topicRoute",
      "request": "launch",
      "mainClass": "org.apache.rocketmq.tools.command.MQAdminStartup",
      "projectName": "rocketmq-tools",
      "args": [
        "topicRoute",
        "-n",
        "127.0.0.1:9876",
        "--topic",
        "TopicTest"
      ],
      "vmArgs": "-Duser.home=/workspaces/rocketmq/develop/mqadmin",
      "env": {
        "ROCKETMQ_HOME": "/workspaces/rocketmq/develop/mqadmin"
      }
    },
    // Producer
    {
      "type": "java",
      "name": "quickstart:Producer",
      "request": "launch",
      "mainClass": "org.apache.rocketmq.example.quickstart.Producer",
      "projectName": "rocketmq-example",
      "env": {
        "NAMESRV_ADDR": "127.0.0.1:9876",
        "ROCKETMQ_HOME": "/workspaces/rocketmq/develop/producer"
      }
    },
    // Consumer
    {
      "type": "java",
      "name": "quickstart:Consumer",
      "request": "launch",
      "mainClass": "org.apache.rocketmq.example.quickstart.Consumer",
      "projectName": "rocketmq-example",
      "env": {
        "NAMESRV_ADDR": "127.0.0.1:9876",
        "ROCKETMQ_HOME": "/workspaces/rocketmq/develop/consumer"
      }
    },
  ]
}